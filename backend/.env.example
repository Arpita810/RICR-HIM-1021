PORT=5000
NODE_ENV=development

# ── DATABASE ────────────────────────────────────────────────────────────────────
# MongoDB — REQUIRED (server will not start without successful connection)
# Encode special characters: @ → %40  # → %23  : → %3A
# Example: mongodb+srv://USER:PASS%40123@cluster0.xxxxx.mongodb.net/esamadhan?retryWrites=true&w=majority
# SECURITY: Use strong passwords and IP allowlist on MongoDB Atlas
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/esamadhan?retryWrites=true&w=majority&appName=Cluster0

# Fallback for SRV connection issues (use "Standard" connection from Atlas)
# MONGO_URI_STANDARD=mongodb://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net:27017/esamadhan?retryWrites=true&w=majority

# Local MongoDB (optional for development)
# MONGO_URI=mongodb://127.0.0.1:27017/esamadhan

# ── AUTHENTICATION ──────────────────────────────────────────────────────────────
# JWT Secret — REQUIRED
# SECURITY: Must be 32+ characters of random data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER hardcode in source; store only in .env
JWT_SECRET=your_random_jwt_secret_min_32_chars_generated_via_crypto
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Admin Registration Secret — for securing admin account creation
# SECURITY: Use strong random value, not predictable
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET_KEY=your_random_admin_secret_min_32_chars

# ── EMAIL / SMTP ────────────────────────────────────────────────────────────────
# REQUIRED for OTP verification and password reset
# For Gmail: Use 16-character App Password (not your regular password)
# SECURITY: Never expose SMTP_PASSWORD in logs, responses, or frontend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_app_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
FROM_EMAIL=noreply@esamadhan.gov.in
FROM_NAME=e-Samadhan AI

# ── FRONTEND / CORS ─────────────────────────────────────────────────────────────
# REQUIRED for CORS configuration
# Development: http://localhost:5173
# Production: https://your-vercel-domain.vercel.app
# SECURITY: Never use "*" when credentials/JWT are required
CLIENT_URL=http://localhost:5173

# ── API KEYS / CREDENTIALS ──────────────────────────────────────────────────────
# Google Gemini API — REQUIRED for AI complaint analysis
# SECURITY: Keep private; never expose to frontend; use backend proxy only
GEMINI_API_KEY=your_google_gemini_api_key

# Google Maps API — Optional for maps features
# SECURITY: Never expose directly to frontend; implement backend proxy
# If exposed, restrict to specific domains in Google Cloud Console
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── DEVELOPMENT OPTIONS ────────────────────────────────────────────────────────
# Reset database on every server startup (DEVELOPMENT ONLY)
# NEVER enable in production — production database is always protected
DEV_RESET_DATABASE=true
AUTO_CLEAR_DB=false

# Legacy clear flag (kept for compatibility — prefer DEV_RESET_DATABASE)
# AUTO_CLEAR_DB=true
# CLEAR_COLLECTIONS=users,complaints

# Liveness — development helpers
# DISABLE_LIVENESS_RATE_LIMIT=true
# AUTO_RESET_LIVENESS=true
